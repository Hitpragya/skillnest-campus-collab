# Copy to server/.env (never commit the real file). Placeholders only.
PORT=4000
NODE_ENV=development
# Required in production: a random string of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret
# Defaults to server/data/peernest.sqlite. In production point this at a persistent disk.
DATABASE_PATH=./data/peernest.sqlite
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:8080
# Defaults to ../engine/build/peernest_worker(.exe)
PEERNEST_ENGINE_PATH=../engine/build/peernest_worker
