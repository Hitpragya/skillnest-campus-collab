# Copy to server/.env (never commit the real file). Placeholders only.
PORT=4000
NODE_ENV=development
# Required in production: a random string of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret
# --- Database: choose ONE mode ---
# Local mode (default): SQLite file. Defaults to server/data/peernest.sqlite.
DATABASE_PATH=./data/peernest.sqlite
# Free online mode: PostgreSQL (e.g. Neon). When set, it is used instead of SQLite.
# Set the real value only in your shell/.env or the hosting dashboard; never commit it.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:8080
# Defaults to ../engine/build/peernest_worker(.exe)
PEERNEST_ENGINE_PATH=../engine/build/peernest_worker
